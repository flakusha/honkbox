+/// Cooperative cancellation for a generation in flight.
+///
+/// Share a handle with a worker thread running [`gen_img_with_cancel`] and
+/// call [`CancelHandle::cancel`] from another thread: a side watcher
+/// relays the flag into `sd_cancel_generation`, which the engine polls
+/// between sampling steps. [`CancelHandle::new`] (the default) stops the
+/// generation as soon as possible — the FFI call returns without an image
+/// and the wrapper reports [`DiffusionError::Cancelled`];
+/// [`CancelHandle::graceful`] finishes the current image and skips further
+/// batch latents, returning whatever completed normally.
+#[derive(Clone, Debug)]
+pub struct CancelHandle {
+    flag: Arc<AtomicBool>,
+    mode: sd_cancel_mode_t,
+}
+
+impl Default for CancelHandle {
+    fn default() -> Self {
+        Self::new()
+    }
+}
+
+impl CancelHandle {
+    /// Hard stop: interrupt the generation mid-sampling; no image.
+    #[must_use]
+    pub fn new() -> Self {
+        Self {
+            flag: Arc::new(AtomicBool::new(false)),
+            mode: sd_cancel_mode_t::SD_CANCEL_ALL,
+        }
+    }
+
+    /// Graceful stop: finish the current image, skip further batch latents.
+    #[must_use]
+    pub fn graceful() -> Self {
+        Self {
+            flag: Arc::new(AtomicBool::new(false)),
+            mode: sd_cancel_mode_t::SD_CANCEL_NEW_LATENTS,
+        }
+    }
+
+    /// Ask the in-flight generation to stop.
+    pub fn cancel(&self) {
+        self.flag.store(true, Ordering::Release);
+    }
+
+    /// Whether a cancellation has been requested.
+    #[must_use]
+    pub fn is_cancelled(&self) -> bool {
+        self.flag.load(Ordering::Acquire)
+    }
+
+    /// The configured engine cancel mode.
+    #[must_use]
+    pub fn mode(&self) -> sd_cancel_mode_t {
+        self.mode
+    }
+
+    fn shared_flag(&self) -> Arc<AtomicBool> {
+        Arc::clone(&self.flag)
+    }
+}
+
+/// The generation context, shared with the cancel watcher thread while the
+/// generation owns it: `sd_cancel_generation` only stores a lock-free
+/// atomic through the pointer (the engine guarantees that with a
+/// `static_assert`), and the context outlives the `generate_image` call
+/// it races with. `Send` is the watcher-thread plumbing, nothing more.
+struct CancelCtx(*mut sd_ctx_t);
+
+unsafe impl Send for CancelCtx {}
+
+impl CancelCtx {
+    fn ptr(&self) -> *mut sd_ctx_t {
+        self.0
+    }
+}
