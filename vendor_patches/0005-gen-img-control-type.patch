+/// Parse a ControlNet type by the engine's name or alias (`none`,
+/// `openpose`, `depth`, `scribble`, `canny`, `normal`, `segment`, `tile`,
+/// `repaint`, plus the engine aliases like `lineart`/`hed`): `None` = the
+/// name is not one the engine knows (`str_to_sd_control_type` returns
+/// COUNT for those).
+#[must_use]
+pub fn parse_control_type(name: &str) -> Option<sd_control_type_t> {
+    let c_name = CString::new(name).ok()?;
+    let parsed = unsafe { str_to_sd_control_type(c_name.as_ptr()) };
+    (parsed != sd_control_type_t::SD_CONTROL_TYPE_COUNT).then_some(parsed)
+}
