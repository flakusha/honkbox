// Provenance: original (one-shot depthwise causal convolution written from first principles; no upstream derivative).
// License: AGPL-3.0-or-later via REUSE.toml (repo has no per-file SPDX headers).
#version 450

// One invocation per output element. Left zero padding is kernel - 1;
// stride and dilation are one and no state survives the dispatch.
layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(std430, binding = 0) readonly buffer Input { float values[]; };
layout(std430, binding = 1) readonly buffer Weights { float weights[]; };
layout(std430, binding = 2) buffer Output { float result[]; };
layout(std430, binding = 3) readonly buffer Shape { uint dims[4]; }; // rows, channels, time, kernel

void main() {
    uint index = gl_GlobalInvocationID.x;
    uint channels = dims[1];
    uint time = dims[2];
    uint kernel = dims[3];
    if (index >= dims[0] * channels * time) {
        return;
    }
    uint row = index / (channels * time);
    uint channel = (index / time) % channels;
    uint t = index % time;
    uint base = (row * channels + channel) * time;
    uint shift = kernel - 1;
    float sum = 0.0;
    for (uint k = 0; k < kernel; ++k) {
        uint source = t + k;
        if (source >= shift) {
            sum += weights[channel * kernel + k] * values[base + source - shift];
        }
    }
    result[index] = sum;
}