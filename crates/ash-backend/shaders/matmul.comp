// Provenance: original (row-major GEMM from the Vulkan compute model; no upstream derivative).
// License: AGPL-3.0-or-later via REUSE.toml (repo has no per-file SPDX headers).
#version 450

// One thread per output element. Correctness first: tiling and subgroup
// reductions arrive when throughput matters, not for this slice.
layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(std430, binding = 0) readonly buffer Left { float lhs[]; };
layout(std430, binding = 1) readonly buffer Right { float rhs[]; };
layout(std430, binding = 2) buffer Out { float result[]; };
layout(std430, binding = 3) readonly buffer Shape { uint dims[3]; }; // m, k, n

void main() {
    uint row = gl_GlobalInvocationID.x;
    uint col = gl_GlobalInvocationID.y;
    uint m = dims[0];
    uint k = dims[1];
    uint n = dims[2];
    if (row >= m || col >= n) {
        return;
    }
    float sum = 0.0;
    for (uint i = 0; i < k; ++i) {
        sum += lhs[row * k + i] * rhs[i * n + col];
    }
    result[row * n + col] = sum;
}
