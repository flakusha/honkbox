// Provenance: original (DDIM eta=0 update written from the published formula; no upstream derivative).
// License: AGPL-3.0-or-later via REUSE.toml (repo has no per-file SPDX headers).
#version 450

// One invocation per latent element. The eta=0 DDIM update predicts x0 from
// (x_t, eps) then re-noises with the previous step's alpha.
// ponytail: eta=0 only; add stochastic eta > 0 when a sampler asks for it.
layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(std430, binding = 0) readonly buffer Latent { float x[]; };
layout(std430, binding = 1) readonly buffer Prediction { float eps[]; };
layout(std430, binding = 2) buffer Output { float result[]; };
layout(std430, binding = 3) readonly buffer Params {
    uint values[5];
}; // len, sqrt(a_t), sqrt(1-a_t), sqrt(a_prev), sqrt(1-a_prev) — float bits

void main() {
    uint index = gl_GlobalInvocationID.x;
    if (index >= values[0]) {
        return;
    }
    float sqrt_alpha = uintBitsToFloat(values[1]);
    float sqrt_one_minus_alpha = uintBitsToFloat(values[2]);
    float sqrt_alpha_prev = uintBitsToFloat(values[3]);
    float sqrt_one_minus_alpha_prev = uintBitsToFloat(values[4]);

    float predicted_x0 = (x[index] - sqrt_one_minus_alpha * eps[index]) / sqrt_alpha;
    result[index] = sqrt_alpha_prev * predicted_x0 + sqrt_one_minus_alpha_prev * eps[index];
}
