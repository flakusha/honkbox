// Provenance: original (LeakyReLU slope 0.2 from the published formula; no upstream derivative).
// License: AGPL-3.0-or-later via REUSE.toml (repo has no per-file SPDX headers).
#version 450

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(std430, binding = 0) readonly buffer Input { float values[]; };
layout(std430, binding = 1) readonly buffer Spare { uint spare[]; };
layout(std430, binding = 2) buffer Output { float result[]; };
layout(std430, binding = 3) readonly buffer Shape { uint dims[1]; };

void main() {
    uint index = gl_GlobalInvocationID.x;
    if (index >= dims[0]) {
        return;
    }
    float x = values[index];
    result[index] = x < 0.0 ? 0.2 * x : x;
}
