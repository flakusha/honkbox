#version 450

// One invocation per output element: out[token, dim] = table[ids[token], dim].
// Token IDs are range-checked on the host before dispatch.
layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(std430, binding = 0) readonly buffer Table { float values[]; };
layout(std430, binding = 1) readonly buffer Ids { uint ids[]; };
layout(std430, binding = 2) buffer Output { float result[]; };
layout(std430, binding = 3) readonly buffer Params {
    uint dims[3];
}; // tokens, vocab, dim

void main() {
    uint index = gl_GlobalInvocationID.x;
    if (index >= dims[0] * dims[2]) {
        return;
    }
    uint token = index / dims[2];
    uint column = index % dims[2];
    result[index] = values[ids[token] * dims[2] + column];
}
