#version 450

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(std430, binding = 0) readonly buffer Gate { float gate[]; };
layout(std430, binding = 1) readonly buffer Up { float up[]; };
layout(std430, binding = 2) buffer Output { float result[]; };
layout(std430, binding = 3) readonly buffer Shape { uint dims[1]; };

void main() {
    uint index = gl_GlobalInvocationID.x;
    if (index >= dims[0]) {
        return;
    }
    float gated = gate[index] / (1.0 + exp(-gate[index]));
    result[index] = gated * up[index];
}