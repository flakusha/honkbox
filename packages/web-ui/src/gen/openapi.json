{
  "openapi": "3.1.0",
  "info": {
    "title": "honkbox-server",
    "description": "",
    "license": {
      "name": "AGPL-3.0-or-later",
      "identifier": "AGPL-3.0-or-later"
    },
    "version": "0.1.0"
  },
  "paths": {
    "/api/version": {
      "get": {
        "tags": [],
        "summary": "Binary name + version.",
        "operationId": "get_version",
        "responses": {
          "200": {
            "description": "Binary name and version",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Version"
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "tags": [],
        "summary": "Liveness probe.",
        "operationId": "health",
        "responses": {
          "200": {
            "description": "Server is alive",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/metrics": {
      "get": {
        "tags": [],
        "summary": "`GET /metrics`: minimal Prometheus text exposition (vLLM-vocabulary\nsubset; see `metrics`).",
        "operationId": "metrics_endpoint",
        "responses": {
          "200": {
            "description": "Prometheus text exposition",
            "content": {
              "text/plain": {}
            }
          }
        }
      }
    },
    "/v1/catalog": {
      "get": {
        "tags": [],
        "summary": "`GET /v1/catalog`: the curated manifest merged with the local scan\nsnapshot. Match by (kind, file name); fit pills (`ok`/`slow`/`fail`)\ncompute only from the matched file's bytes against\n`[models] vram_budget_bytes` — without a budget the advisory fields are\nomitted and entries show manifest metadata + local bytes only. Pills\nare advice, never enforcement.",
        "operationId": "get_catalog",
        "responses": {
          "200": {
            "description": "Curated catalog with local presence + fit pills",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CatalogList"
                }
              }
            }
          }
        }
      }
    },
    "/v1/chat": {
      "post": {
        "tags": [],
        "summary": "`POST /v1/chat`: sync worker call inside `spawn_blocking`; the residency\nlease is held across the call. Only the server edge is async.",
        "operationId": "post_chat",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Chat completion",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChatResponse"
                }
              }
            }
          },
          "400": {
            "description": "Unknown model slug"
          },
          "429": {
            "description": "GPU slot busy"
          },
          "500": {
            "description": "Inference failed"
          }
        }
      }
    },
    "/v1/chat/stream": {
      "post": {
        "tags": [],
        "summary": "`POST /v1/chat/stream`: same blocking call, tokens forwarded as SSE\n(`data: {\"token\":\"...\"}` + `data: [DONE]`) over an unbounded channel so\nthe sink never blocks the worker thread.",
        "description": "Disconnect handling: dropping the SSE body sets a cancel flag and calls\nthe pipeline `abort` hook; the worker notices at its **next token\nboundary** — token delivery stops, the GPU residency lease is freed, and\nthe synchronous FFI loop exits at its next internal checkpoint (per-token\ndecode returns to our loop, so early return needs no FFI-level abort).",
        "operationId": "post_chat_stream",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "SSE token stream"
          },
          "400": {
            "description": "Unknown model slug"
          },
          "429": {
            "description": "GPU slot busy"
          },
          "500": {
            "description": "Inference failed"
          }
        }
      }
    },
    "/v1/downloads": {
      "get": {
        "tags": [],
        "summary": "`GET /v1/downloads`: every known download with its progress (poll\ncontract; no SSE).",
        "operationId": "list_downloads",
        "responses": {
          "200": {
            "description": "Known downloads",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DownloadList"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [],
        "summary": "`POST /v1/downloads`: start one managed download into the configured\nmodels root. `{repo, file, kind}` derives the `HuggingFace` resolve URL\n(and enforces the LFS sha256 when the repo API publishes one); `url` is\nthe direct-source alternative. A second pull of the same target file\njoins the in-flight download (same id); a target that already exists\nresolves immediately as `done` + `already_present`.",
        "operationId": "post_download",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DownloadRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "Download accepted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DownloadAccepted"
                }
              }
            }
          },
          "400": {
            "description": "Missing/ambiguous source, bad repo id, or unusable file name"
          },
          "500": {
            "description": "No managed models root or target directory create failed"
          }
        }
      }
    },
    "/v1/downloads/{id}": {
      "get": {
        "tags": [],
        "summary": "`GET /v1/downloads/{id}`: one download's progress; 404 for an unknown id.",
        "operationId": "get_download",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Download id from the POST acceptance body",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Download state",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DownloadState"
                }
              }
            }
          },
          "404": {
            "description": "Unknown download id"
          }
        }
      },
      "delete": {
        "tags": [],
        "summary": "`DELETE /v1/downloads/{id}`: cancel a download (204). The task stops at\nthe next chunk boundary, deletes the `.part` + meta sidecar, and lands\nin `cancelled`; a queued download never starts. 409 once terminal.",
        "operationId": "delete_download",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Download id from the POST acceptance body",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Cancellation triggered"
          },
          "404": {
            "description": "Unknown download id"
          },
          "409": {
            "description": "Download already finished"
          }
        }
      }
    },
    "/v1/models": {
      "get": {
        "tags": [],
        "summary": "`GET /v1/models`: the discovered-model catalog as an OpenAI-style list\nenvelope (`{object: \"list\", data: [...]}`). Served from the shared scan\nsnapshot; `POST /v1/models/refresh` re-scans and swaps it.",
        "operationId": "get_models",
        "responses": {
          "200": {
            "description": "Discovered model catalog",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ModelCatalog"
                }
              }
            }
          }
        }
      }
    },
    "/v1/models/refresh": {
      "post": {
        "tags": [],
        "summary": "`POST /v1/models/refresh`: re-scan the configured registry roots and\nswap the shared catalog snapshot, returning the fresh body. Idempotent;\nmissing or unreadable roots never fail the request (the scan is lenient —\nthey contribute empty results). Root *configuration* still needs a\nrestart; refresh picks up files added under the configured roots.",
        "operationId": "refresh_models",
        "responses": {
          "200": {
            "description": "Freshly scanned model catalog",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ModelCatalog"
                }
              }
            }
          }
        }
      }
    },
    "/v1/openapi.json": {
      "get": {
        "tags": [],
        "summary": "`OpenAPI` 3.1 document as JSON.",
        "operationId": "openapi_json",
        "responses": {
          "200": {
            "description": "OpenAPI document"
          }
        }
      }
    },
    "/v1/synthesize": {
      "post": {
        "tags": [],
        "summary": "`POST /v1/synthesize`: JSON in, WAV bytes out (`audio/wav`).",
        "operationId": "post_synthesize",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SynthesizeRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "WAV audio"
          },
          "400": {
            "description": "Unknown model slug"
          },
          "429": {
            "description": "GPU slot busy"
          },
          "500": {
            "description": "Synthesis failed"
          }
        }
      }
    },
    "/v1/transcribe": {
      "post": {
        "tags": [],
        "summary": "`POST /v1/transcribe`: content-type dispatch (`audio/wav` → `decode_wav`,\n`audio/pcm-s16le` → raw LE bytes + required `?sample_rate=`), then the\nsync worker call inside `spawn_blocking`.",
        "operationId": "post_transcribe",
        "responses": {
          "200": {
            "description": "Transcription",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Transcript"
                }
              }
            }
          },
          "400": {
            "description": "Unknown model, bad audio, or missing sample_rate"
          },
          "415": {
            "description": "Use audio/wav or audio/pcm-s16le"
          },
          "429": {
            "description": "GPU slot busy"
          },
          "500": {
            "description": "Transcription failed"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CatalogEntry": {
        "type": "object",
        "description": "One curated catalog offering (`GET /v1/catalog`). The manifest is a\nchecked-in JSON list — review-by-PR is the signature; entries carry a\n`verified_date` and rot without it (12 months ⇒ drop at release).",
        "required": [
          "id",
          "repo",
          "file",
          "kind",
          "quant",
          "license",
          "verified_date",
          "notes"
        ],
        "properties": {
          "file": {
            "type": "string",
            "description": "File path inside `repo` (last segment is the local file name)."
          },
          "id": {
            "type": "string",
            "description": "Stable manifest id (e.g. `llama-3.2-1b-q4`); NOT a catalog slug."
          },
          "kind": {
            "$ref": "#/components/schemas/ModelKind",
            "description": "Modality (drives the download target dir and the pill factor)."
          },
          "license": {
            "type": "string",
            "description": "Model license tag (e.g. `apache-2.0`, `llama3.2`)."
          },
          "local": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/CatalogLocal",
                "description": "Local scan presence + fit pill; absent when not found under the\nscanned roots."
              },
              {
                "type": "null"
              }
            ]
          },
          "notes": {
            "type": "string",
            "description": "Short human note (why this entry is curated)."
          },
          "quant": {
            "type": "string",
            "description": "Quantization/format tag (e.g. `Q4_K_M`, `fp16`)."
          },
          "repo": {
            "type": "string",
            "description": "`HuggingFace` repo id the file downloads from (`owner/name`)."
          },
          "verified_date": {
            "type": "string",
            "description": "Manual verification month (`YYYY-MM`); entries unverified for 12\nmonths are dropped at release."
          }
        }
      },
      "CatalogList": {
        "type": "object",
        "description": "Curated catalog envelope (`GET /v1/catalog`), OpenAI-style list shape.",
        "required": [
          "object",
          "data"
        ],
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CatalogEntry"
            },
            "description": "Curated entries, sorted by id."
          },
          "object": {
            "type": "string",
            "description": "Always `\"list\"` (OpenAI-compatible envelope)."
          }
        }
      },
      "CatalogLocal": {
        "type": "object",
        "description": "Local scan presence for one curated catalog entry (`GET /v1/catalog`);\nabsent when no scanned root holds a matching file.",
        "required": [
          "slug",
          "bytes"
        ],
        "properties": {
          "bytes": {
            "type": "integer",
            "format": "int64",
            "description": "On-disk weight size in bytes (the pill's byte input).",
            "minimum": 0
          },
          "est_vram_bytes": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "description": "Estimated VRAM need (advisory heuristic, not a measurement); absent\nwithout a configured `[models] vram_budget_bytes`.",
            "minimum": 0
          },
          "pill": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/Pill",
                "description": "Fit pill vs the configured budget; absent without one."
              },
              {
                "type": "null"
              }
            ]
          },
          "slug": {
            "type": "string",
            "description": "Matched catalog slug (`llm:…` / `comfy:…` / `stt:…` / `tts:…`)."
          }
        }
      },
      "ChatMessage": {
        "type": "object",
        "description": "One chat message.",
        "required": [
          "role",
          "content"
        ],
        "properties": {
          "content": {
            "type": "string",
            "description": "Message text."
          },
          "role": {
            "$ref": "#/components/schemas/ChatRole",
            "description": "Who said it."
          }
        }
      },
      "ChatRequest": {
        "type": "object",
        "description": "Chat completion request.",
        "required": [
          "model",
          "messages"
        ],
        "properties": {
          "max_tokens": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32",
            "description": "Max tokens to generate; backend default when absent.",
            "minimum": 0
          },
          "messages": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ChatMessage"
            },
            "description": "Conversation turns."
          },
          "model": {
            "type": "string",
            "description": "Model id (informational; the backend is chosen by the server)."
          },
          "temperature": {
            "type": [
              "number",
              "null"
            ],
            "format": "float",
            "description": "Sampling temperature; backend default when absent."
          },
          "ttl_seconds": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "description": "Per-request residency budget for this model's swap entry, in seconds\n(NEW-8; the Ollama `keep_alive` / LM Studio `ttl` analog). The entry's\neffective window is `max(remaining, this)`, capped at\n`[swap] max_ttl_secs`; `0` = use-then-unload, still shielded by the\nremaining window so it cannot thrash. Values over the cap are clamped\nat the route (`warn!`, never a 400); `[swap] pin` entries ignore it\nentirely. Ignored when the swap manager is off (stub backends,\n`[swap] enabled = false`).",
            "minimum": 0
          }
        }
      },
      "ChatResponse": {
        "type": "object",
        "description": "Chat completion response.",
        "required": [
          "backend_id",
          "text",
          "tokens",
          "millis"
        ],
        "properties": {
          "backend_id": {
            "type": "string",
            "description": "Which backend produced this."
          },
          "millis": {
            "type": "integer",
            "format": "int64",
            "description": "Wall-clock time in milliseconds.",
            "minimum": 0
          },
          "text": {
            "type": "string",
            "description": "Generated text."
          },
          "tokens": {
            "type": "integer",
            "format": "int32",
            "description": "Number of generated tokens.",
            "minimum": 0
          }
        }
      },
      "ChatRole": {
        "type": "string",
        "description": "Chat role.",
        "enum": [
          "user",
          "assistant",
          "system"
        ]
      },
      "DownloadAccepted": {
        "type": "object",
        "description": "202 acceptance body (`POST /v1/downloads`).",
        "required": [
          "id",
          "state"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "Download id (`dl_<ulid>`); poll/cancel with it."
          },
          "state": {
            "$ref": "#/components/schemas/DownloadStatus",
            "description": "State at acceptance: `queued` normally, `done` when the target file\nalready existed (`already_present`), or the in-flight state when an\nidentical download is already running (single-flight join)."
          }
        }
      },
      "DownloadKind": {
        "type": "string",
        "description": "Download modality target (`POST /v1/downloads`): picks the managed\n`<data_dir>/models` subdir the completed file lands in (and labels the\ndownload metrics). The on-disk `ModelKind` set is wider (`lora`,\n`embedding`, `vae` come from `ComfyUI` category dirs); downloads only\ntarget the four root modalities.",
        "enum": [
          "llm",
          "sd",
          "stt",
          "tts"
        ]
      },
      "DownloadList": {
        "type": "object",
        "description": "Download list envelope (`GET /v1/downloads`).",
        "required": [
          "downloads"
        ],
        "properties": {
          "downloads": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DownloadState"
            },
            "description": "Known downloads, sorted by id."
          }
        }
      },
      "DownloadRequest": {
        "type": "object",
        "description": "Start one managed download (`POST /v1/downloads`).",
        "required": [
          "kind"
        ],
        "properties": {
          "file": {
            "type": [
              "string",
              "null"
            ],
            "description": "File path inside `repo` (its last segment becomes the local file\nname)."
          },
          "kind": {
            "$ref": "#/components/schemas/DownloadKind",
            "description": "Target modality (see `DownloadKind`)."
          },
          "repo": {
            "type": [
              "string",
              "null"
            ],
            "description": "`HuggingFace` repo id (`owner/name`); together with `file` it derives\nthe source URL `https://huggingface.co/{repo}/resolve/main/{file}`\nand enables the LFS sha256 checksum check when the API reports one."
          },
          "url": {
            "type": [
              "string",
              "null"
            ],
            "description": "Direct download URL; the alternative to `repo` + `file`. Exactly one\nsource form must be present."
          }
        }
      },
      "DownloadState": {
        "type": "object",
        "description": "One managed download's progress (`GET /v1/downloads[/id]`).",
        "required": [
          "id",
          "state",
          "bytes_done",
          "source",
          "resumable"
        ],
        "properties": {
          "already_present": {
            "type": "boolean",
            "description": "`done` because the target file already existed (no bytes fetched)."
          },
          "bytes_done": {
            "type": "integer",
            "format": "int64",
            "description": "Bytes committed to the `.part` file so far.",
            "minimum": 0
          },
          "bytes_total": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "description": "Expected total size; absent until the server reports a length\n(and on terminal states where none was ever learned).",
            "minimum": 0
          },
          "error": {
            "type": [
              "string",
              "null"
            ],
            "description": "Failure reason (only when `state` is `failed`)."
          },
          "id": {
            "type": "string",
            "description": "Download id (`dl_<ulid>`)."
          },
          "resumable": {
            "type": "boolean",
            "description": "Ranged resume is possible for this source: the server supplied a\nstrong `ETag` (usable as `If-Range` validator) and advertised\n`Accept-Ranges: bytes`. `false` means the next pull cold-restarts."
          },
          "source": {
            "type": "string",
            "description": "Source URL the bytes are fetched from."
          },
          "state": {
            "$ref": "#/components/schemas/DownloadStatus",
            "description": "Lifecycle state."
          },
          "target_path": {
            "type": [
              "string",
              "null"
            ],
            "description": "Final file path under the managed models root."
          }
        }
      },
      "DownloadStatus": {
        "type": "string",
        "description": "Download lifecycle state (`GET /v1/downloads` polling).",
        "enum": [
          "queued",
          "running",
          "resuming",
          "done",
          "failed",
          "cancelled"
        ]
      },
      "GgufMetadata": {
        "type": "object",
        "description": "GGUF header summary (`GET /v1/models` entry `metadata`).",
        "required": [
          "version",
          "tensor_count"
        ],
        "properties": {
          "architecture": {
            "type": [
              "string",
              "null"
            ],
            "description": "`general.architecture` KV string, when present."
          },
          "name": {
            "type": [
              "string",
              "null"
            ],
            "description": "`general.name` KV string, when present."
          },
          "tensor_count": {
            "type": "integer",
            "format": "int64",
            "description": "Tensor count declared in the header.",
            "minimum": 0
          },
          "version": {
            "type": "integer",
            "format": "int32",
            "description": "GGUF spec version.",
            "minimum": 0
          }
        }
      },
      "Health": {
        "type": "object",
        "description": "Liveness probe response.",
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "type": "string",
            "description": "Always `\"ok\"` while the server is alive."
          }
        }
      },
      "ModelCatalog": {
        "type": "object",
        "description": "Model catalog: OpenAI-style list envelope (`GET /v1/models`).",
        "required": [
          "object",
          "data"
        ],
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ModelCatalogEntry"
            },
            "description": "Discovered models, sorted by id."
          },
          "object": {
            "type": "string",
            "description": "Always `\"list\"` (OpenAI-compatible envelope)."
          }
        }
      },
      "ModelCatalogEntry": {
        "type": "object",
        "description": "One discovered model in the catalog (`GET /v1/models`).",
        "required": [
          "id",
          "kind",
          "category",
          "path",
          "bytes"
        ],
        "properties": {
          "bytes": {
            "type": "integer",
            "format": "int64",
            "description": "File size in bytes.",
            "minimum": 0
          },
          "category": {
            "type": "string",
            "description": "Directory category (`checkpoints`, `loras`, LLM parent dir, or `root`)."
          },
          "id": {
            "type": "string",
            "description": "Registry slug, the stable request-facing id (`llm:…` / `comfy:…`)."
          },
          "kind": {
            "$ref": "#/components/schemas/ModelKind",
            "description": "Modality derived from the scanned root."
          },
          "metadata": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/ModelMetadata",
                "description": "Header-derived metadata (GGUF/safetensors); absent when the file has\nno probeable header or the header is invalid."
              },
              {
                "type": "null"
              }
            ]
          },
          "path": {
            "type": "string",
            "description": "Absolute path to the weight file."
          }
        }
      },
      "ModelKind": {
        "type": "string",
        "description": "Model modality as discovered on disk (`GET /v1/models` entries). Mirrors\nthe registry's on-disk kinds.",
        "enum": [
          "llm",
          "sd",
          "lora",
          "embedding",
          "vae",
          "stt",
          "tts"
        ]
      },
      "ModelMetadata": {
        "oneOf": [
          {
            "allOf": [
              {
                "$ref": "#/components/schemas/GgufMetadata",
                "description": "`.gguf`: llama.cpp container header."
              },
              {
                "type": "object",
                "required": [
                  "format"
                ],
                "properties": {
                  "format": {
                    "type": "string",
                    "enum": [
                      "gguf"
                    ]
                  }
                }
              }
            ],
            "description": "`.gguf`: llama.cpp container header."
          },
          {
            "allOf": [
              {
                "$ref": "#/components/schemas/SafetensorsMetadata",
                "description": "`.safetensors`: `HuggingFace` container header."
              },
              {
                "type": "object",
                "required": [
                  "format"
                ],
                "properties": {
                  "format": {
                    "type": "string",
                    "enum": [
                      "safetensors"
                    ]
                  }
                }
              }
            ],
            "description": "`.safetensors`: `HuggingFace` container header."
          }
        ],
        "description": "Optional on-disk header metadata, tagged by container format."
      },
      "Pill": {
        "type": "string",
        "description": "Fit-pill verdict for a curated catalog entry against the configured\n`[models] vram_budget_bytes`. Estimates are advisory heuristics (per-kind\noverhead factors over weight bytes), never a measurement.",
        "enum": [
          "ok",
          "slow",
          "fail"
        ]
      },
      "SafetensorsMetadata": {
        "type": "object",
        "description": "Safetensors header summary (`GET /v1/models` entry `metadata`).",
        "required": [
          "tensor_count",
          "dtypes"
        ],
        "properties": {
          "dtypes": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Unique dtype names, sorted (`F32`, `F16`, `BF16`, …)."
          },
          "tensor_count": {
            "type": "integer",
            "format": "int64",
            "description": "Tensor entries in the JSON header (`__metadata__` excluded).",
            "minimum": 0
          }
        }
      },
      "SynthesizeRequest": {
        "type": "object",
        "description": "Speech synthesis request.",
        "required": [
          "model",
          "text"
        ],
        "properties": {
          "model": {
            "type": "string",
            "description": "Model id (informational; the backend is chosen by the server)."
          },
          "sample_rate": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32",
            "description": "Output sample rate in Hz; backend default when absent.",
            "minimum": 0
          },
          "text": {
            "type": "string",
            "description": "Text to synthesize."
          },
          "ttl_seconds": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "description": "Per-request residency budget for this model's swap entry, in seconds\n(NEW-8; same contract as [`ChatRequest::ttl_seconds`]). Over-cap\nvalues are clamped at the route; audio pipelines are startup-loaded\ntoday, so the advice takes effect once per-kind swap lands.",
            "minimum": 0
          },
          "voice": {
            "type": [
              "string",
              "null"
            ],
            "description": "Voice name; backend default when absent."
          }
        }
      },
      "Transcript": {
        "type": "object",
        "description": "Transcription result.",
        "required": [
          "backend_id",
          "text",
          "segments",
          "millis"
        ],
        "properties": {
          "backend_id": {
            "type": "string",
            "description": "Which backend produced this."
          },
          "millis": {
            "type": "integer",
            "format": "int64",
            "description": "Wall-clock time in milliseconds.",
            "minimum": 0
          },
          "segments": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TranscriptSegment"
            },
            "description": "Timestamped segments, in order."
          },
          "text": {
            "type": "string",
            "description": "Full transcription text."
          }
        }
      },
      "TranscriptSegment": {
        "type": "object",
        "description": "One transcript segment.",
        "required": [
          "start_ms",
          "end_ms",
          "text"
        ],
        "properties": {
          "end_ms": {
            "type": "integer",
            "format": "int32",
            "description": "Segment end, milliseconds from the audio start.",
            "minimum": 0
          },
          "start_ms": {
            "type": "integer",
            "format": "int32",
            "description": "Segment start, milliseconds from the audio start.",
            "minimum": 0
          },
          "text": {
            "type": "string",
            "description": "Segment text."
          }
        }
      },
      "Version": {
        "type": "object",
        "description": "Binary name + version response.",
        "required": [
          "name",
          "version"
        ],
        "properties": {
          "name": {
            "type": "string",
            "description": "Binary name, always `\"honkbox\"`."
          },
          "version": {
            "type": "string",
            "description": "Crate version, from `CARGO_PKG_VERSION`."
          }
        }
      }
    }
  }
}
