{
  "openapi": "3.1.0",
  "info": {
    "title": "sd-rip-server",
    "description": "",
    "license": {
      "name": "AGPL-3.0-or-later",
      "identifier": "AGPL-3.0-or-later"
    },
    "version": "0.1.0"
  },
  "paths": {
    "/api/version": {
      "get": {
        "tags": [],
        "summary": "Binary name + version.",
        "operationId": "get_version",
        "responses": {
          "200": {
            "description": "Binary name and version",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Version"
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "tags": [],
        "summary": "Liveness probe.",
        "operationId": "health",
        "responses": {
          "200": {
            "description": "Server is alive",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/v1/openapi.json": {
      "get": {
        "tags": [],
        "summary": "`OpenAPI` 3.1 document as JSON.",
        "operationId": "openapi_json",
        "responses": {
          "200": {
            "description": "OpenAPI document"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Health": {
        "type": "object",
        "description": "Liveness probe response.",
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "type": "string",
            "description": "Always `\"ok\"` while the server is alive."
          }
        }
      },
      "Version": {
        "type": "object",
        "description": "Binary name + version response.",
        "required": [
          "name",
          "version"
        ],
        "properties": {
          "name": {
            "type": "string",
            "description": "Binary name, always `\"sd-rip\"`."
          },
          "version": {
            "type": "string",
            "description": "Crate version, from `CARGO_PKG_VERSION`."
          }
        }
      }
    }
  }
}
