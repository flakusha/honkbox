{
  "$schema": "https://raw.githubusercontent.com/SchemaStore/schemastore/master/src/schemas/json/package.json",
  "name": "honkbox",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "workspaces": ["packages/*"],
  "engines": {
    "bun": ">=1.4.4"
  },
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "dev:web": "bun run docs:api && vite --port 5173 packages/web-ui",
    "dev:server": "cargo watch -x 'run -p honkbox-server -- serve --dev'",
    "build": "bun run build:vendor && bun run build:web && bun run build:server",
    "build:web": "vite build packages/web-ui && bun run docs:api",
    "build:vendor": "bun scripts/build-vendor.ts",
    "build:server": "cargo build --locked -p honkbox-server",
    "build:rs": "cargo build --workspace --locked",
    "build:release": "cargo build --release --locked -p honkbox-server --features release",
    "install:local": "bun scripts/install.ts",
    "uninstall:local": "bun scripts/uninstall.ts",
    "hooks:install": "git config core.hooksPath .githooks",
    "hooks:check": "sh -n .githooks/pre-commit && sh -n .githooks/pre-push && test -x .githooks/pre-commit && test -x .githooks/pre-push",
    "check": "bun run hooks:check && bun run format && bun run lint && bun run typecheck && bun run lint:rs && bun run audit:gpu-slot && bun run codegen:check && bun run docs:api:check",
    "audit:gpu-slot": "bun scripts/audit-gpu-slot.ts",
    "format": "dprint check",
    "format:fix": "dprint fmt",
    "lint": "oxlint scripts packages",
    "size": "bun scripts/check-file-size.ts",
    "size:strict": "bun scripts/check-file-size.ts --strict",
    "lint:padding": "bun scripts/check-padding.ts",
    "lint:padding:fix": "bun scripts/check-padding.ts --fix",
    "typecheck": "tsc --noEmit",
    "test": "bun test --isolate --pass-with-no-tests && cargo test --workspace --locked && dprint fmt packages/web-ui/src/gen >/dev/null",
    "test:unit": "bun test --isolate --pass-with-no-tests",
    "test:rs": "cargo test --workspace --locked",
    "test:api-types": "cargo test --locked -p honkbox-api-types",
    "test:core": "cargo test --locked -p honkbox-sd-core",
    "test:llm": "cargo test --locked -p honkbox-llm-worker",
    "test:audio": "cargo test --locked -p honkbox-audio-worker",
    "test:residency": "cargo test --locked -p honkbox-residency",
    "test:registry": "cargo test --locked -p honkbox-registry",
    "test:server": "cargo test --locked -p honkbox-server",
    "test:parity": "cargo test --locked -p honkbox-sd-core --test parity -- --include-ignored",
    "lint:rs": "cargo clippy --workspace --all-targets -- -D warnings",
    "fmt:rs": "cargo fmt --all",
    "fmt:rs:check": "cargo fmt --all -- --check",
    "doc:rs": "RUSTDOCFLAGS=-D warnings cargo doc --workspace --no-deps",
    "docs:api": "typedoc --entryPoints packages/web-ui/src/gen/api-types.ts --out web-dist/api-docs --tsconfig packages/web-ui/tsconfig.json --readme none --hideGenerator --name \"Honkbox API types\"",
    "docs:api:check": "bun run docs:api && bun scripts/docs-api-check.ts",
    "deny": "cargo deny check licenses bans advisories",
    "spdx": "reuse lint",
    "notice": "cargo about generate about.hbs -o NOTICE",
    "codegen:check": "cargo test --locked -p honkbox-api-types && bun scripts/codegen-openapi-check.ts && dprint fmt packages/web-ui/src/gen >/dev/null && git diff --exit-code -- packages/web-ui/src/gen/",
    "ci": "bun run check && bun run test && bun run build"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "dprint": "^0.64.3",
    "oxlint": "^1.93.0",
    "typedoc": "^0.28.20",
    "typescript": "5.9.3",
    "vite": "^8.3.8"
  }
}
