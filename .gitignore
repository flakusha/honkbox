# Rust build output
/target/

# Fetched third-party trees (dynamic checkout + patches, never committed)
vendor/

# TS / bun
node_modules/
dist/
bun.lockb

# Generated web bundle: keep the dir (rust-embed needs it), ignore contents
web-dist/*

# Local data
*.db*
*.db-journal
*.sqlite*

# Models / weights (vendored or downloaded, never committed)
models/
weights/
*.safetensors
*.gguf
*.ggml
*.pt
*.pth
*.ckpt
*.onnx

# Fetched vendored sources (never committed): `bun scripts/vendor-patches.ts sync`
# converges vendor/ from vendor.manifest.toml pins + vendor_patches/ stack.
# No trailing slash: worktrees link this as a symlink, which `/vendor/` misses.
/vendor

# Env / secrets
.env*
.credentials.env

# Scratch research + coverage
.tmp/
coverage/
lcov.info

# Python bytecode from the embedded Blender recipes (probe/test scratch)
__pycache__/
*.py[cod]

# Re-include repo dirs shadowed by global `.*/` dot-dir ignores (core.excludesFile).
# .github/ (CI) and .githooks/ (hooks) MUST be tracked; repo .gitignore wins
# over the global file by precedence, and negating the dir re-includes it.
!.github/
!.githooks/
!.plan/
tree
